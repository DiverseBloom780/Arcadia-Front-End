<Window x:Class="Arcadia.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Arcadia Frontend"
        Height="1080"
        Width="1920"
        WindowState="Maximized"
        WindowStyle="None"
        Background="Black"
        KeyDown="Window_KeyDown">
    
    <Window.Resources>
        <!-- Style for the main navigation buttons in the header -->
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#00D9FF"/>
                                <Setter Property="BorderBrush" Value="#00D9FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RailButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D8FFFFFF"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="12,3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="railBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="railBorder" Property="Background" Value="#2200D9FF"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="railBorder" Property="Background" Value="#4400D9FF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Background Video/Theme -->
        <MediaElement x:Name="BackgroundVideo" 
                      LoadedBehavior="Manual" 
                      UnloadedBehavior="Stop"
                      Stretch="UniformToFill"
                      Opacity="0.3"/>

        <!-- Main Content Grid -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>     <!-- Row 0: Header/Navigation Buttons -->
                <RowDefinition Height="*"/>        <!-- Row 1: ContentArea -->
                <RowDefinition Height="200"/>     <!-- Row 2: Footer/Keybinds -->
            </Grid.RowDefinitions>

            <!-- Row 0: Header Section -->
            <Grid Grid.Row="0" Background="#20000000">
                <!-- Arcadia Title and Clock -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="40,0">
                    <TextBlock Text="ARCADIA" 
                               FontSize="48" 
                               FontWeight="Bold" 
                               Foreground="#00D9FF"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="ClockText" 
                               FontSize="20" 
                               Foreground="White" 
                               Margin="20,0,0,0"
                               VerticalAlignment="Bottom"
                               Text="--:--:--"/>
                </StackPanel>

                <TextBlock Text="GAME CENTER" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Margin="0,0,48,0" Foreground="#88FFFFFF" FontSize="16"/>
            </Grid>

            <!-- Row 1: MAIN CONTENT AREA (ContentArea) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#CC0D1017" BorderBrush="#2200D9FF" BorderThickness="0,0,1,0">
                    <StackPanel Margin="0,24,0,0">
                        <TextBlock Text="NAVIGATION" Foreground="#6699AABB" FontSize="12" FontWeight="Bold" Margin="30,0,0,12"/>
                        <Button Content="🎮   GAME WHEEL" Click="GamesButton_Click" Style="{StaticResource RailButtonStyle}"/>
                        <Button Content="📚   LIBRARY" Click="LibraryButton_Click" Style="{StaticResource RailButtonStyle}"/>
                        <Button Content="📰   DISCOVER" Click="NewsButton_Click" Style="{StaticResource RailButtonStyle}"/>
                        <Button Content="⚙    SETTINGS" Click="SettingsButton_Click" Style="{StaticResource RailButtonStyle}"/>
                        <Button Content="↻    UPDATER" Click="UpdaterButton_Click" Style="{StaticResource RailButtonStyle}"/>
                        <Separator Margin="25,18" Background="#2288AACC"/>
                        <Button Content="✦    SMART WIZARD" Click="SmartWizardButton_Click" Style="{StaticResource RailButtonStyle}"/>
                    </StackPanel>
                </Border>
                <Grid x:Name="ContentArea" Grid.Column="1" Margin="18,0,0,0">
                    <!-- Active view is hosted here. -->
                </Grid>
            </Grid>
            
            <!-- Row 2: Footer Section (Keybinds) -->
            <Grid Grid.Row="2" Background="#10FFFFFF">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#20FFFFFF" Padding="15,10" Margin="10" CornerRadius="5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ENTER" FontSize="20" Foreground="#00D9FF" Margin="0,0,10,0" FontWeight="Bold"/>
                            <TextBlock Text="Launch Game" FontSize="18" Foreground="White"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#20FFFFFF" Padding="15,10" Margin="10" CornerRadius="5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="F1" FontSize="20" Foreground="#00D9FF" Margin="0,0,10,0" FontWeight="Bold"/>
                            <TextBlock Text="Settings" FontSize="18" Foreground="White"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#20FFFFFF" Padding="15,10" Margin="10" CornerRadius="5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="F2" FontSize="20" Foreground="#00D9FF" Margin="0,0,10,0" FontWeight="Bold"/>
                            <TextBlock Text="Search" FontSize="18" Foreground="White"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#20FFFFFF" Padding="15,10" Margin="10" CornerRadius="5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ESC" FontSize="20" Foreground="#00D9FF" Margin="0,0,10,0" FontWeight="Bold"/>
                            <TextBlock Text="Exit" FontSize="18" Foreground="White"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Loading Overlay -->
        <Grid x:Name="SearchOverlay" Background="#EE080A0F" Visibility="Collapsed" Panel.ZIndex="20">
            <Border Width="760" MaxHeight="760" Padding="28" Background="#F21A1D26"
                    BorderBrush="#6600D9FF" BorderThickness="1" CornerRadius="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="SEARCH YOUR LIBRARY" Foreground="#00D9FF"
                               FontSize="24" FontWeight="Bold"/>
                    <TextBox x:Name="SearchBox" Grid.Row="1" Margin="0,18,0,16"
                             Height="52" Padding="14,8" FontSize="22"
                             Foreground="White" Background="#33FFFFFF"
                             BorderBrush="#6600D9FF" BorderThickness="1"
                             TextChanged="SearchBox_TextChanged"
                             KeyDown="SearchBox_KeyDown"/>
                    <ListBox x:Name="SearchResults" Grid.Row="2" MinHeight="180"
                             Background="Transparent" BorderThickness="0"
                             Foreground="White" FontSize="18"
                             SelectionChanged="SearchResults_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10" Margin="0,0,0,6" Background="#22FFFFFF" CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                                        <TextBlock Foreground="#99FFFFFF" FontSize="13">
                                            <Run Text="{Binding Platform}"/>
                                            <Run Text="  •  "/>
                                            <Run Text="{Binding Publisher}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" Background="#DD000000" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="LOADING..." 
                           FontSize="48" 
                           Foreground="#00D9FF" 
                           HorizontalAlignment="Center"
                           FontWeight="Bold"/>
                <ProgressBar Width="400" 
                             Height="10" 
                             Margin="0,30,0,0"
                             IsIndeterminate="True"
                             Foreground="#00D9FF"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
