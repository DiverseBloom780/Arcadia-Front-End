<Window x:Class="Arcadia.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arcadia Frontend" Height="720" Width="1280"
        Background="Black" WindowStyle="None" AllowsTransparency="True"
        WindowState="{Binding CurrentWindowState}"
        KeyDown="OnKeyDown">
    <Grid>
        <!-- Direct3D11 Render Surface -->
        <Image Name="D3DSurface" Stretch="Fill" />

        <!-- Smart Wizard Terminal Overlay -->
        <Grid Name="SmartWizardOverlay" Visibility="Collapsed" Background="#CC000000">
            <Border BorderBrush="#44FFFFFF" BorderThickness="1" CornerRadius="5" 
                    VerticalAlignment="Bottom" Margin="50" Padding="20" Background="#EE111111">
                <StackPanel>
                    <TextBlock Name="TerminalHistory" Foreground="#FFAAAAAA" 
                               FontSize="14" FontFamily="Consolas" TextWrapping="Wrap" 
                               MaxHeight="300" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
                    <DockPanel>
                        <TextBlock Text=">" Foreground="#FF00FF00" FontSize="18" 
                                   FontFamily="Consolas" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBox Name="TerminalInput" Background="Transparent" BorderThickness="0" 
                                 Foreground="White" FontSize="18" FontFamily="Consolas" 
                                 CaretBrush="White" KeyDown="OnTerminalKeyDown"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
        
        <!-- Selected Game Info Overlay -->
        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="40">
            <TextBlock Text="{Binding SelectedGame.Title}" Foreground="White" 
                       FontSize="48" FontWeight="Bold"/>
            <TextBlock Text="{Binding SelectedGame.Platform}" Foreground="#FFAAAAAA" 
                       FontSize="24"/>
            <TextBlock Text="{Binding SelectedGame.Description}" Foreground="#88FFFFFF" 
                       FontSize="14" Width="400" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Window>