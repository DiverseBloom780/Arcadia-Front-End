<UserControl x:Class="Arcadia.UI.Tabs.GamesTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Arcadia.UI.Controls"
             Background="Black"
             KeyDown="UserControl_KeyDown"
             Focusable="True"
             Loaded="UserControl_Loaded">
    
    <Grid>
        <!-- Dynamic Background Art with Blur and Gradient Overlay -->
        <Image x:Name="BackgroundImage" Stretch="UniformToFill" Opacity="0.4">
            <Image.Effect>
                <BlurEffect Radius="25" RenderingBias="Quality"/>
            </Image.Effect>
        </Image>
        
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#40000000" Offset="0" />
                    <GradientStop Color="#FF0B0C10" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1.5*" />
            </Grid.ColumnDefinitions>

            <!-- Game Overview Panel (Left) -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="100,0,0,0">
                <TextBlock x:Name="GameTitleText" Text="Select a Game" 
                           FontSize="72" FontWeight="Black" Foreground="White" TextWrapping="Wrap">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock x:Name="GameDeveloperText" Text="Developer // Publisher" 
                           FontSize="24" Foreground="#00D9FF" Margin="0,10,0,20" FontWeight="SemiBold"/>
                
                <Border Background="#22000000" CornerRadius="10" Padding="15" Margin="0,0,50,0">
                    <TextBlock x:Name="GameDescriptionText" 
                               Text="No description available."
                               FontSize="18" Foreground="#E0E0E0" 
                               TextWrapping="Wrap" MaxWidth="700" LineHeight="28" />
                </Border>
                
                <Button Content="PLAY NOW" Style="{StaticResource AccentButtonStyle}"
                        Click="PlayButton_Click"
                        HorizontalAlignment="Left" Margin="0,40,0,0" Padding="40,15"/>
            </StackPanel>

            <!-- The Game Wheel Carousel (Right) -->
            <controls:GameWheelControl x:Name="WheelControl" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            
        </Grid>
    </Grid>
</UserControl>
