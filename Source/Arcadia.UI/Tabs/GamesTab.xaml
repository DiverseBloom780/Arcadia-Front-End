        <!-- Selection Pointer -->
        <Path x:Name="SelectionPointer" 
              Data="M 0,0 L 20,10 L 0,20 Z" 
              Fill="Cyan" 
              HorizontalAlignment="Right" 
              VerticalAlignment="Center" 
              Margin="0,0,420,0"
              Width="20" Height="20"
              Stretch="Fill">
            <Path.RenderTransform>
                <TranslateTransform x:Name="PointerTranslate"/>
