<UserControl x:Class="Arcadia.UI.Tabs.SettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#111">
    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Background -->
        <Border Grid.Column="0" Background="#1AFFFFFF" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="0,0,1,0"/>

        <!-- Sidebar Navigation -->
        <StackPanel Grid.Column="0" Margin="0,50,0,0">
            <TextBlock Text="SETTINGS" FontSize="14" FontWeight="Bold" Foreground="#666" Margin="25,0,0,15" />
            <ListBox x:Name="SettingsCategories" 
                     Background="Transparent" 
                     BorderThickness="0"
                     SelectionChanged="SettingsCategories_SelectionChanged"
                     ItemContainerStyle="{StaticResource SidebarButtonStyle}">
                <ListBoxItem Content="General" IsSelected="True" Tag="General" />
                <ListBoxItem Content="UI &amp; Aesthetics" Tag="UI" />
                <ListBoxItem Content="Game Library" Tag="Library" />
                <ListBoxItem Content="Launchers" Tag="Launchers" />
                <ListBoxItem Content="Smart Wizard" Tag="SmartWizard" />
                <ListBoxItem Content="Advanced" Tag="Advanced" />
            </ListBox>
        </StackPanel>

        <!-- Settings Content Area -->
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="40,50">
            <StackPanel x:Name="SettingsContentContainer">
                <!-- Group Title -->
                <TextBlock x:Name="CategoryTitle" Text="General Settings" Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,30" />
                
                <!-- General Settings Panel -->
                <StackPanel x:Name="GeneralSettingsPanel" Visibility="Visible">
                    <Border Style="{StaticResource SettingRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Start Fullscreen" FontSize="18" Foreground="White" />
                                <TextBlock Text="Launch Arcadia in full screen mode by default." FontSize="14" Foreground="#888" />
                            </StackPanel>
                            <CheckBox x:Name="FullscreenToggle" Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Auto-Update" FontSize="18" Foreground="White" />
                                <TextBlock Text="Check for updates automatically on startup." FontSize="14" Foreground="#888" />
                            </StackPanel>
                            <CheckBox x:Name="UpdateToggle" Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- UI Settings Panel -->
                <StackPanel x:Name="UISettingsPanel" Visibility="Collapsed">
                    <Border Style="{StaticResource SettingRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Wheel Orientation" FontSize="18" Foreground="White" />
                                <TextBlock Text="Choose between Vertical or Horizontal wheel layout." FontSize="14" Foreground="#888" />
                            </StackPanel>
                            <ComboBox x:Name="OrientationCombo" Grid.Column="1" Width="150" VerticalAlignment="Center">
                                <ComboBoxItem Content="Vertical" IsSelected="True"/>
                                <ComboBoxItem Content="Horizontal"/>
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Library Settings Panel -->
                <StackPanel x:Name="LibrarySettingsPanel" Visibility="Collapsed">
                    <Border Style="{StaticResource SettingRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Auto-Scan Library" FontSize="18" Foreground="White" />
                                <TextBlock Text="Automatically scan for new games when the app starts." FontSize="14" Foreground="#888" />
                            </StackPanel>
                            <CheckBox x:Name="AutoScanToggle" Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Button Content="SCAN FOR NEW GAMES NOW" 
                            Style="{StaticResource PremiumButtonStyle}" 
                            HorizontalAlignment="Left" Margin="0,10,0,0"
                            Click="ScanLibrary_Click"/>
                </StackPanel>

                <Button x:Name="SaveButton" Content="SAVE CHANGES" 
                        Style="{StaticResource AccentButtonStyle}" 
                        HorizontalAlignment="Left" Margin="0,30,0,0"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
