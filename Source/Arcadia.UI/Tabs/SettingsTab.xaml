<UserControl x:Class="Arcadia.UI.Tabs.SettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0A0A0A">

	<ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40">
		<StackPanel MaxWidth="1200">

			<!-- Header -->
			<TextBlock Text="⚙️ SETTINGS"
                       FontSize="42"
                       FontWeight="Bold"
                       Foreground="#00D9FF"
                       Margin="0,0,0,30"/>

			<!-- General Settings Section -->
			<Border Background="#1A1A1A"
                    Padding="30"
                    Margin="0,0,0,20"
                    CornerRadius="10">
				<StackPanel>
					<TextBlock Text="General Settings"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="#00D9FF"
                               Margin="0,0,0,20"/>

					<!-- Application Name -->
					<Grid Margin="0,0,0,15">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="300"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<TextBlock Text="Application Name:"
                                   VerticalAlignment="Center"
                                   FontSize="16"/>
						<TextBox x:Name="ApplicationNameTextBox"
                                 Grid.Column="1"
                                 Padding="10"
                                 FontSize="16"
                                 Background="#2A2A2A"
                                 Foreground="White"
                                 BorderBrush="#00D9FF"
                                 BorderThickness="1"/>
					</Grid>

					<!-- Version (Read-only) -->
					<Grid Margin="0,0,0,15">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="300"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<TextBlock Text="Version:"
                                   VerticalAlignment="Center"
                                   FontSize="16"/>
						<TextBox x:Name="VersionTextBox"
                                 Grid.Column="1"
                                 Padding="10"
                                 FontSize="16"
                                 Background="#2A2A2A"
                                 Foreground="#888"
                                 BorderBrush="#555"
                                 BorderThickness="1"
                                 IsReadOnly="True"/>
					</Grid>

					<!-- Start Fullscreen -->
					<Grid Margin="0,0,0,15">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="300"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<TextBlock Text="Start in Fullscreen:"
                                   VerticalAlignment="Center"
                                   FontSize="16"/>
						<CheckBox x:Name="StartFullscreenCheckBox"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Foreground="White"
                                  FontSize="16"/>
					</Grid>

					<!-- Check for Updates on Startup -->
					<Grid Margin="0,0,0,15">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="300"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<TextBlock Text="Check for Updates on Startup:"
                                   VerticalAlignment="Center"
                                   FontSize="16"/>
						<CheckBox x:Name="CheckForUpdatesCheckBox"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Foreground="White"
                                  FontSize="16"/>
					</Grid>
				</StackPanel>
			</Border>

			<!-- UI Settings Section -->
			<Border Background="#1A1A1A"
                    Padding="30"
                    Margin="0,0,0,20"
                    CornerRadius="10">
				<StackPanel>
					<TextBlock Text="User Interface"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="#00D9FF"
                               Margin="0,0,0,20"/>

					<!-- Wheel Orientation -->
					<Grid Margin="0,0,0,15">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="300"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<TextBlock Text="Wheel Orientation:"
                                   VerticalAlignment="Center"
                                   FontSize="16"/>
						<ComboBox x:Name="WheelOrientationComboBox"
                                  Grid.Column="1"
                                  Padding="10"
                                  FontSize="16"
                                  Background="#2A2A2A"
                                  Foreground="White"
                                  BorderBrush="#00D9FF">
							<ComboBoxItem Content="Vertical"/>
							<ComboBoxItem Content="Horizontal"/>
							<ComboBoxItem Content="Curved"/>
						</ComboBox>
					</Grid>

					<!-- Theme -->
					<Grid Margin="0,0,0,15">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="300"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<TextBlock Text="Theme:"
                                   VerticalAlignment="Center"
                                   FontSize="16"/>
						<ComboBox x:Name="ThemeComboBox"
                                  Grid.Column="1"
                                  Padding="10"
                                  FontSize="16"
                                  Background="#2A2A2A"
                                  Foreground="White"
                                  BorderBrush="#00D9FF">
							<ComboBoxItem Content="Dark"/>
							<ComboBoxItem Content="Light"/>
						</ComboBox>
					</Grid>

					<!-- Show Video Backgrounds -->
					<Grid Margin="0,0,0,15">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="300"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<TextBlock Text="Show Video Backgrounds:"
                                   VerticalAlignment="Center"
                                   FontSize="16"/>
						<CheckBox x:Name="ShowVideoBackgroundsCheckBox"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Foreground="White"
                                  FontSize="16"/>
					</Grid>

					<!-- Show Game Stats -->
					<Grid Margin="0,0,0,15">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="300"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<TextBlock Text="Show Game Statistics:"
                                   VerticalAlignment="Center"
                                   FontSize="16"/>
						<CheckBox x:Name="ShowGameStatsCheckBox"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Foreground="White"
                                  FontSize="16"/>
					</Grid>

					<!-- Animation Speed -->
					<Grid Margin="0,0,0,15">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="300"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<TextBlock Text="Animation Speed:"
                                   VerticalAlignment="Center"
                                   FontSize="16"/>
						<StackPanel Grid.Column="1" Orientation="Horizontal">
							<Slider x:Name="AnimationSpeedSlider"
                                    Width="300"
                                    Minimum="0.5"
                                    Maximum="2.0"
                                    TickFrequency="0.1"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    Foreground="#00D9FF"/>
							<TextBlock x:Name="AnimationSpeedLabel"
                                       Text="1.0x"
                                       Margin="15,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       Width="50"/>
						</StackPanel>
					</Grid>
				</StackPanel>
			</Border>

			<!-- Game Library Settings Section -->
			<Border Background="#1A1A1A"
                    Padding="30"
                    Margin="0,0,0,20"
                    CornerRadius="10">
				<StackPanel>
					<TextBlock Text="Game Library"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="#00D9FF"
                               Margin="0,0,0,20"/>

					<!-- Auto Scan on Startup -->
					<Grid Margin="0,0,0,15">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="300"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<TextBlock Text="Auto Scan on Startup:"
                                   VerticalAlignment="Center"
                                   FontSize="16"/>
						<CheckBox x:Name="AutoScanCheckBox"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Foreground="White"
                                  FontSize="16"/>
					</Grid>

					<!-- Platform Scanning -->
					<TextBlock Text="Scan for Games From:"
                               FontSize="18"
                               Margin="0,15,0,10"
                               Foreground="#00D9FF"/>

					<CheckBox x:Name="ScanSteamCheckBox"
                              Content="Steam"
                              Margin="20,5"
                              Foreground="White"
                              FontSize="16"/>
					<CheckBox x:Name="ScanGOGCheckBox"
                              Content="GOG Galaxy"
                              Margin="20,5"
                              Foreground="White"
                              FontSize="16"/>
					<CheckBox x:Name="ScanEpicCheckBox"
                              Content="Epic Games Store"
                              Margin="20,5"
                              Foreground="White"
                              FontSize="16"/>
					<CheckBox x:Name="ScanTeknoParrotCheckBox"
                              Content="TeknoParrot"
                              Margin="20,5"
                              Foreground="White"
                              FontSize="16"/>
				</StackPanel>
			</Border>

			<!-- Input Settings Section -->
			<Border Background="#1A1A1A"
                    Padding="30"
                    Margin="0,0,0,20"
                    CornerRadius="10">
				<StackPanel>
					<TextBlock Text="Input Settings"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="#00D9FF"
                               Margin="0,0,0,20"/>

					<!-- Keyboard Enabled -->
					<Grid Margin="0,0,0,15">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="300"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<TextBlock Text="Keyboard Enabled:"
                                   VerticalAlignment="Center"
                                   FontSize="16"/>
						<CheckBox x:Name="KeyboardEnabledCheckBox"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Foreground="White"
                                  FontSize="16"/>
					</Grid>

					<!-- Gamepad Enabled -->
					<Grid Margin="0,0,0,15">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="300"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<TextBlock Text="Gamepad Enabled:"
                                   VerticalAlignment="Center"
                                   FontSize="16"/>
						<CheckBox x:Name="GamepadEnabledCheckBox"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Foreground="White"
                                  FontSize="16"/>
					</Grid>
				</StackPanel>
			</Border>

			<!-- Action Buttons -->
			<StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
				<Button Content="Save Settings"
                        Click="SaveSettings_Click"
                        Padding="30,15"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Margin="0,0,15,0"
                        Background="#00D9FF"
                        Foreground="Black"
                        BorderThickness="0"
                        Cursor="Hand">
					<Button.Style>
						<Style TargetType="Button">
							<Setter Property="Template">
								<Setter.Value>
									<ControlTemplate TargetType="Button">
										<Border Background="{TemplateBinding Background}"
                                                CornerRadius="5"
                                                Padding="{TemplateBinding Padding}">
											<ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
										</Border>
									</ControlTemplate>
								</Setter.Value>
							</Setter>
							<Style.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter Property="Background" Value="#33EEFF"/>
								</Trigger>
							</Style.Triggers>
						</Style>
					</Button.Style>
				</Button>

				<Button Content="Reset to Defaults"
                        Click="ResetSettings_Click"
                        Padding="30,15"
                        FontSize="18"
                        Background="#2A2A2A"
                        Foreground="White"
                        BorderBrush="#555"
                        BorderThickness="2"
                        Cursor="Hand">
					<Button.Style>
						<Style TargetType="Button">
							<Setter Property="Template">
								<Setter.Value>
									<ControlTemplate TargetType="Button">
										<Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="5"
                                                Padding="{TemplateBinding Padding}">
											<ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
										</Border>
									</ControlTemplate>
								</Setter.Value>
							</Setter>
							<Style.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter Property="Background" Value="#3A3A3A"/>
									<Setter Property="BorderBrush" Value="#00D9FF"/>
								</Trigger>
							</Style.Triggers>
						</Style>
					</Button.Style>
				</Button>
			</StackPanel>

		</StackPanel>
	</ScrollViewer>
</UserControl>
